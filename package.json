{
  "name": "repotrail",
  "displayName": "RepoTrail",
  "description": "Capture and recover context from code investigations.",
  "version": "0.0.1",
  "publisher": "repotrail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tahamoeini/repotrail.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repotrail.startInvestigation",
        "title": "Start Investigation",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.saveRecentActivityAsInvestigation",
        "title": "Save Recent Activity as Investigation",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.updateCheckpoint",
        "title": "Add or Update Checkpoint",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.saveAndStopInvestigation",
        "title": "Save and Stop Investigation",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.listInvestigations",
        "title": "List Saved Investigations",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.openResumeSnapshot",
        "title": "Show Resume Snapshot",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.resumeInvestigation",
        "title": "Resume Investigation",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.deleteInvestigation",
        "title": "Delete Investigation",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.deleteAllData",
        "title": "Delete All RepoTrail Data",
        "category": "RepoTrail"
      },
      {
        "command": "repotrail.showStorageLocation",
        "title": "Show Local Storage Location",
        "category": "RepoTrail"
      }
    ],
    "configuration": {
      "title": "RepoTrail",
      "properties": {
        "repotrail.validationMode": {
          "type": "string",
          "enum": [
            "standard",
            "checkpoint-only",
            "checkpoint-git",
            "git-trail"
          ],
          "default": "standard",
          "markdownDescription": "Temporarily limits what RepoTrail saves and shows for early validation. `standard` keeps normal RepoTrail behavior. `checkpoint-only` keeps only the optional checkpoint. `checkpoint-git` keeps the optional checkpoint plus Git state. `git-trail` keeps Git state and the observed trail while disabling checkpoint capture."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vscode-test",
    "test:unit": "mocha out/test/domain.test.js out/test/storage.test.js out/test/capture.test.js out/test/git.test.js out/test/investigationLifecycle.test.js out/test/resumeSnapshot.test.js out/test/resumeAction.test.js --ui tdd",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "mocha": "^12.0.0",
    "typescript": "^5.7.0"
  }
}
